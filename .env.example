# Copy this file to .env and adjust the values to your environment.
# The real .env is git-ignored: never commit it.

# --- Server ---
# Port the HTTP server listens on.
PORT=3000
# development | test | production. In development, 500 errors include the stack trace.
NODE_ENV=development

# --- Database ---
# MongoDB connection string. The last path segment is the database name.
MONGODB_URI=mongodb://127.0.0.1:27017/garden_monitoring

# --- Authentication (JWT) ---
# Secret used to sign and verify access tokens. Use a long random string (min. 16 characters).
JWT_SECRET=replace_with_a_long_random_secret
# Token lifetime, in the format accepted by jsonwebtoken (e.g. 15m, 8h, 1d).
JWT_EXPIRES_IN=8h

# --- Initial administrator ---
# On startup, an admin account is created with these credentials if no admin exists yet.
ADMIN_EMAIL=admin@garden.local
ADMIN_PASSWORD=ChangeThisPassword123!