{
  "openapi": "3.0.3",
  "info": {
    "title": "Garden Monitoring API",
    "version": "1.0.0",
    "description": "REST API to monitor a garden: sensors, the readings they produce and the users that manage them.\n\nAll responses share the same envelope: `{ status: \"success\", data }` on success and `{ status: \"fail\" | \"error\", error, message, details? }` on error.\n\n**Authentication:** call `POST /auth/login` (or `/auth/register`) to get a JWT, press **Authorize** and paste it. Every sensor route needs it; creating, updating and deleting sensors also needs the `admin` role. Readings can be registered and read by any authenticated user."
  },
  "servers": [{ "url": "/api", "description": "Current server" }],
  "security": [{ "bearerAuth": [] }],
  "tags": [
    { "name": "System", "description": "Service status" },
    { "name": "Auth", "description": "Sign up and log in to get an access token (JWT). Public routes." },
    {
      "name": "Sensors",
      "description": "Garden sensors. Each sensor measures one magnitude and has its own normal range; the unit is set by the server from the magnitude."
    },
    {
      "name": "Readings",
      "description": "Measurements sent by the sensors. The server decides whether each reading is anomalous when it is saved. Readings cannot be modified or deleted."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Check that the API is running (Public)",
        "security": [],
        "responses": {
          "200": {
            "description": "The API is up",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Create a user account (Public)",
        "description": "Always creates a regular `user`: a `role` sent in the body is ignored. Returns a token so the client is logged in straight away.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "409": { "$ref": "#/components/responses/EmailAlreadyRegistered" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in and get a token (Public)",
        "description": "The same 401 is returned whether the email does not exist or the password is wrong, so the API never reveals which emails are registered.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/InvalidCredentials" }
        }
      }
    },
    "/sensors": {
      "get": {
        "tags": ["Sensors"],
        "summary": "List all sensors (Any authenticated user)",
        "description": "Any authenticated user. Returns every sensor, newest first.",
        "responses": {
          "200": {
            "description": "The list of sensors",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SensorListResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Sensors"],
        "summary": "Create a sensor (Admin only)",
        "description": "Admin only. The unit is derived from the magnitude (% for soil_humidity, °C for temperature, lx for light); a unit sent by the client is ignored. minThreshold, when present, must be lower than maxThreshold.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateSensorRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Sensor created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SensorResponse" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/sensors/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/SensorId" }],
      "get": {
        "tags": ["Sensors"],
        "summary": "Get a sensor by id (Any authenticated user)",
        "description": "Any authenticated user.",
        "responses": {
          "200": {
            "description": "The sensor",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SensorResponse" } } }
          },
          "400": { "$ref": "#/components/responses/InvalidObjectId" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/SensorNotFound" }
        }
      },
      "patch": {
        "tags": ["Sensors"],
        "summary": "Update a sensor partially (Admin only)",
        "description": "Admin only. Send only the fields to change (at least one). The magnitude cannot be changed. The threshold range is checked against the values already stored, so sending only minThreshold can still fail.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateSensorRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Sensor updated",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SensorResponse" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/SensorNotFound" }
        }
      },
      "delete": {
        "tags": ["Sensors"],
        "summary": "Delete a sensor (Admin only)",
        "description": "Admin only. A sensor that already has readings cannot be deleted (409): deactivate it instead.",
        "responses": {
          "204": { "description": "Sensor deleted (no body)" },
          "400": { "$ref": "#/components/responses/InvalidObjectId" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/SensorNotFound" },
          "409": { "$ref": "#/components/responses/SensorHasReadings" }
        }
      }
    },
    "/readings": {
      "get": {
        "tags": ["Readings"],
        "summary": "List the readings history (Any authenticated user)",
        "description": "Any authenticated user. Paginated, filterable and sortable history of readings. Every filter sent adds one condition and they combine with AND (for example `?sensor=<id>&isAnomalous=true&sort=-value&limit=10`). Each reading comes with its sensor populated. `magnitude` filters by the magnitude of the sensor (the reading does not store it). The `links` keep every filter of the request, so following `next` returns the next page of the same query. Readings with the same sort value are ordered by id, so pages never repeat or skip a reading.",
        "parameters": [
          { "name": "page", "in": "query", "description": "Page number", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          {
            "name": "limit",
            "in": "query",
            "description": "Readings per page",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          },
          {
            "name": "sensor",
            "in": "query",
            "description": "Only readings of this sensor (MongoDB id, 24 hexadecimal characters)",
            "schema": { "type": "string", "example": "6716a2f4c1d2e3f4a5b6c7d8" }
          },
          {
            "name": "magnitude",
            "in": "query",
            "description": "Only readings of sensors that measure this magnitude",
            "schema": { "$ref": "#/components/schemas/Magnitude" }
          },
          {
            "name": "isAnomalous",
            "in": "query",
            "description": "true: only anomalous readings; false: only normal ones",
            "schema": { "type": "boolean" }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Only readings taken at or after this date (ISO 8601)",
            "schema": { "type": "string", "format": "date-time", "example": "2026-10-20T00:00:00Z" }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Only readings taken at or before this date (ISO 8601). Cannot be earlier than `from`",
            "schema": { "type": "string", "format": "date-time", "example": "2026-10-24T23:59:59Z" }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort field; a leading `-` means descending",
            "schema": { "type": "string", "enum": ["-timestamp", "timestamp", "-value", "value"], "default": "-timestamp" }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of readings",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadingListResponse" } } }
          },
          "400": { "$ref": "#/components/responses/ReadingQueryBadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Readings"],
        "summary": "Register a reading (Any authenticated user)",
        "description": "Any authenticated user. The sensor must exist and be active. The unit is optional: if sent, it must match the sensor unit (the server does not convert units). isAnomalous is always computed by the server from the sensor thresholds at the moment of saving (the range is inclusive); a value sent by the client is ignored. timestamp is optional (defaults to now) and cannot be in the future.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateReadingRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Reading registered",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadingResponse" } } }
          },
          "400": { "$ref": "#/components/responses/ReadingBadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/SensorNotFound" },
          "409": { "$ref": "#/components/responses/SensorInactive" }
        }
      }
    },
    "/readings/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ReadingId" }],
      "get": {
        "tags": ["Readings"],
        "summary": "Get a reading by id (Any authenticated user)",
        "description": "Any authenticated user. The sensor is returned populated with its name, magnitude, location and unit.",
        "responses": {
          "200": {
            "description": "The reading, with its sensor",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadingDetailResponse" } } }
          },
          "400": { "$ref": "#/components/responses/InvalidObjectId" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/ReadingNotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Paste the token returned by /auth/login or /auth/register (without the word Bearer)."
      }
    },
    "parameters": {
      "SensorId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "MongoDB id of the sensor (24 hexadecimal characters)",
        "schema": { "type": "string", "example": "6716a2f4c1d2e3f4a5b6c7d8" }
      },
      "ReadingId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "MongoDB id of the reading (24 hexadecimal characters)",
        "schema": { "type": "string", "example": "6716c3b2c1d2e3f4a5b6c7e0" }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "The request data is not valid (missing fields, wrong types, thresholds out of order, invalid id...)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "status": "fail",
              "error": "ValidationError",
              "message": "The request data is not valid.",
              "details": [{ "field": "minThreshold", "message": "minThreshold must be lower than maxThreshold" }]
            }
          }
        }
      },
      "InvalidObjectId": {
        "description": "The id in the URL is not a valid MongoDB id",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "status": "fail",
              "error": "InvalidObjectId",
              "message": "'abc' is not a valid id (expected 24 hexadecimal characters)."
            }
          }
        }
      },
      "SensorNotFound": {
        "description": "No sensor exists with that id",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "status": "fail", "error": "NotFound", "message": "Sensor not found: 6716a2f4c1d2e3f4a5b6c7d8" }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, invalid or expired token",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "status": "fail",
              "error": "Unauthorized",
              "message": "Authentication required: send the header 'Authorization: Bearer <token>'"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Valid token, but the role is not allowed (admin only)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "status": "fail", "error": "Forbidden", "message": "Your role does not allow this action" }
          }
        }
      },
      "InvalidCredentials": {
        "description": "Wrong email or password",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "status": "fail", "error": "InvalidCredentials", "message": "Invalid email or password" }
          }
        }
      },
      "EmailAlreadyRegistered": {
        "description": "The email is already registered",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "status": "fail",
              "error": "EmailAlreadyRegistered",
              "message": "This email is already registered"
            }
          }
        }
      },
      "ReadingBadRequest": {
        "description": "Invalid data, or a unit that does not match the sensor",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "examples": {
              "validation": {
                "summary": "Invalid data",
                "value": {
                  "status": "fail",
                  "error": "ValidationError",
                  "message": "The request data is not valid.",
                  "details": [{ "field": "timestamp", "message": "timestamp cannot be in the future" }]
                }
              },
              "unitMismatch": {
                "summary": "Unit does not match the sensor",
                "value": {
                  "status": "fail",
                  "error": "UnitMismatch",
                  "message": "Unit '°F' does not match the sensor unit '°C'"
                }
              }
            }
          }
        }
      },
      "ReadingQueryBadRequest": {
        "description": "The query string is not valid (limit out of 1-100, sort not allowed, isAnomalous not true/false, from later than to, invalid sensor id...)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "status": "fail",
              "error": "ValidationError",
              "message": "The request data is not valid.",
              "details": [
                { "field": "isAnomalous", "message": "isAnomalous must be true or false" },
                { "field": "sort", "message": "sort must be one of: timestamp, value (add \"-\" in front for descending order)" }
              ]
            }
          }
        }
      },
      "SensorInactive": {
        "description": "The sensor is inactive and does not accept readings",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "status": "fail",
              "error": "Conflict",
              "message": "Sensor 6716a2f4c1d2e3f4a5b6c7d8 is inactive and does not accept readings"
            }
          }
        }
      },
      "SensorHasReadings": {
        "description": "The sensor has readings and cannot be deleted",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "status": "fail",
              "error": "Conflict",
              "message": "Sensor 6716a2f4c1d2e3f4a5b6c7d8 has readings and cannot be deleted; deactivate it instead"
            }
          }
        }
      },
      "ReadingNotFound": {
        "description": "No reading exists with that id",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "status": "fail",
              "error": "NotFound",
              "message": "Reading not found: 6716c3b2c1d2e3f4a5b6c7e0"
            }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": {
            "type": "object",
            "properties": {
              "service": { "type": "string", "example": "garden-monitoring-api" },
              "uptimeSeconds": { "type": "number", "example": 42.17 }
            }
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["email", "password", "name"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "ana@garden.com" },
          "password": { "type": "string", "minLength": 8, "maxLength": 72, "example": "secret123" },
          "name": { "type": "string", "minLength": 2, "maxLength": 100, "example": "Ana" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "ana@garden.com" },
          "password": { "type": "string", "example": "secret123" }
        }
      },
      "User": {
        "type": "object",
        "description": "A user as returned by the API (the password hash is never included).",
        "properties": {
          "_id": { "type": "string", "example": "6716b0a1c1d2e3f4a5b6c7d9" },
          "email": { "type": "string", "example": "ana@garden.com" },
          "name": { "type": "string", "example": "Ana" },
          "role": { "type": "string", "enum": ["user", "admin"], "example": "user" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": {
            "type": "object",
            "properties": {
              "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
              "user": { "$ref": "#/components/schemas/User" }
            }
          }
        }
      },
      "Magnitude": { "type": "string", "enum": ["soil_humidity", "temperature", "light"], "example": "temperature" },
      "Sensor": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "6716a2f4c1d2e3f4a5b6c7d8" },
          "name": { "type": "string", "example": "Bed thermometer" },
          "magnitude": { "$ref": "#/components/schemas/Magnitude" },
          "location": { "type": "string", "example": "Bed 1" },
          "isActive": { "type": "boolean", "example": true },
          "minThreshold": { "type": "number", "example": 5 },
          "maxThreshold": { "type": "number", "example": 35 },
          "unit": { "type": "string", "enum": ["%", "°C", "lx"], "example": "°C" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateSensorRequest": {
        "type": "object",
        "required": ["name", "magnitude", "location", "maxThreshold"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 100, "example": "Bed thermometer" },
          "magnitude": { "$ref": "#/components/schemas/Magnitude" },
          "location": { "type": "string", "minLength": 2, "maxLength": 100, "example": "Bed 1" },
          "minThreshold": { "type": "number", "description": "Optional lower limit of the normal range", "example": 5 },
          "maxThreshold": { "type": "number", "description": "Upper limit of the normal range", "example": 35 }
        }
      },
      "UpdateSensorRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 100 },
          "location": { "type": "string", "minLength": 2, "maxLength": 100 },
          "isActive": { "type": "boolean", "example": false },
          "minThreshold": { "type": "number" },
          "maxThreshold": { "type": "number" }
        }
      },
      "SensorResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "$ref": "#/components/schemas/Sensor" }
        }
      },
      "SensorListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Sensor" } }
        }
      },
      "CreateReadingRequest": {
        "type": "object",
        "required": ["sensor", "value"],
        "properties": {
          "sensor": {
            "type": "string",
            "description": "Id of the sensor that took the measurement",
            "example": "6716a2f4c1d2e3f4a5b6c7d8"
          },
          "value": { "type": "number", "example": 41 },
          "unit": { "type": "string", "description": "Optional; must match the sensor unit", "example": "°C" },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Optional ISO 8601 date (defaults to now; cannot be in the future)",
            "example": "2026-10-22T10:30:00Z"
          }
        }
      },
      "Reading": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "6716c3b2c1d2e3f4a5b6c7e0" },
          "sensor": { "type": "string", "description": "Id of the sensor", "example": "6716a2f4c1d2e3f4a5b6c7d8" },
          "value": { "type": "number", "example": 41 },
          "unit": { "type": "string", "enum": ["%", "°C", "lx"], "example": "°C" },
          "timestamp": { "type": "string", "format": "date-time", "description": "When the value was measured" },
          "isAnomalous": {
            "type": "boolean",
            "example": true,
            "description": "Computed by the server: true if the value is outside the sensor range"
          },
          "createdAt": { "type": "string", "format": "date-time", "description": "When the reading was saved" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ReadingWithSensor": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "6716c3b2c1d2e3f4a5b6c7e0" },
          "sensor": {
            "type": "object",
            "description": "The sensor, populated",
            "properties": {
              "_id": { "type": "string", "example": "6716a2f4c1d2e3f4a5b6c7d8" },
              "name": { "type": "string", "example": "Bed thermometer" },
              "magnitude": { "$ref": "#/components/schemas/Magnitude" },
              "location": { "type": "string", "example": "Bed 1" },
              "unit": { "type": "string", "example": "°C" }
            }
          },
          "value": { "type": "number", "example": 41 },
          "unit": { "type": "string", "enum": ["%", "°C", "lx"], "example": "°C" },
          "timestamp": { "type": "string", "format": "date-time", "description": "When the value was measured" },
          "isAnomalous": {
            "type": "boolean",
            "example": true,
            "description": "Computed by the server: true if the value is outside the sensor range"
          },
          "createdAt": { "type": "string", "format": "date-time", "description": "When the reading was saved" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ReadingResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "$ref": "#/components/schemas/Reading" }
        }
      },
      "ReadingDetailResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "$ref": "#/components/schemas/ReadingWithSensor" }
        }
      },
      "ReadingListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/ReadingWithSensor" } },
          "meta": { "$ref": "#/components/schemas/PaginationMeta" },
          "links": { "$ref": "#/components/schemas/PaginationLinks" }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "total": { "type": "integer", "description": "Readings that match the filters", "example": 3 },
          "page": { "type": "integer", "example": 1 },
          "limit": { "type": "integer", "example": 2 },
          "totalPages": { "type": "integer", "example": 2 },
          "hasNextPage": { "type": "boolean", "example": true },
          "hasPrevPage": { "type": "boolean", "example": false }
        }
      },
      "PaginationLinks": {
        "type": "object",
        "description": "Ready-to-follow URLs that keep every filter of the request",
        "properties": {
          "first": {
            "type": "string",
            "example": "/api/readings?sensor=6716a2f4c1d2e3f4a5b6c7d8&isAnomalous=true&sort=-value&limit=2&page=1"
          },
          "prev": { "type": "string", "nullable": true, "example": null },
          "next": {
            "type": "string",
            "nullable": true,
            "example": "/api/readings?sensor=6716a2f4c1d2e3f4a5b6c7d8&isAnomalous=true&sort=-value&limit=2&page=2"
          },
          "last": {
            "type": "string",
            "example": "/api/readings?sensor=6716a2f4c1d2e3f4a5b6c7d8&isAnomalous=true&sort=-value&limit=2&page=2"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["status", "error", "message"],
        "properties": {
          "status": { "type": "string", "enum": ["fail", "error"], "example": "fail" },
          "error": { "type": "string", "example": "ValidationError" },
          "message": { "type": "string", "example": "The request data is not valid." },
          "details": {
            "type": "array",
            "description": "Only present on validation errors: one entry per invalid field.",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string", "example": "maxThreshold" },
                "message": { "type": "string", "example": "Expected number, received string" }
              }
            }
          }
        }
      }
    }
  }
}
