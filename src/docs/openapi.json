{
  "openapi": "3.0.3",
  "info": {
    "title": "Garden Monitoring API",
    "version": "1.0.0",
    "description": "REST API to monitor a garden: sensors, the readings they produce and the users that manage them.\n\nAll responses share the same envelope: `{ status: \"success\", data }` on success and `{ status: \"fail\" | \"error\", error, message, details? }` on error."
  },
  "servers": [
    {
      "url": "/api",
      "description": "Current server"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Service status"
    },
    {
      "name": "Sensors",
      "description": "Garden sensors. Each sensor measures one magnitude and has its own normal range; the unit is set by the server from the magnitude."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Check that the API is running",
        "responses": {
          "200": {
            "description": "The API is up",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/sensors": {
      "get": {
        "tags": ["Sensors"],
        "summary": "List all sensors",
        "description": "Returns every sensor, newest first.",
        "responses": {
          "200": {
            "description": "The list of sensors",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SensorListResponse" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Sensors"],
        "summary": "Create a sensor",
        "description": "The unit is derived from the magnitude (% for soil_humidity, °C for temperature, lx for light); a unit sent by the client is ignored. minThreshold, when present, must be lower than maxThreshold.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateSensorRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sensor created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SensorResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/sensors/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/SensorId" }],
      "get": {
        "tags": ["Sensors"],
        "summary": "Get a sensor by id",
        "responses": {
          "200": {
            "description": "The sensor",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SensorResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidObjectId" },
          "404": { "$ref": "#/components/responses/SensorNotFound" }
        }
      },
      "patch": {
        "tags": ["Sensors"],
        "summary": "Update a sensor partially",
        "description": "Send only the fields to change (at least one). The magnitude cannot be changed. The threshold range is checked against the values already stored, so sending only minThreshold can still fail.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateSensorRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sensor updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SensorResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "404": { "$ref": "#/components/responses/SensorNotFound" }
        }
      },
      "delete": {
        "tags": ["Sensors"],
        "summary": "Delete a sensor",
        "responses": {
          "204": { "description": "Sensor deleted (no body)" },
          "400": { "$ref": "#/components/responses/InvalidObjectId" },
          "404": { "$ref": "#/components/responses/SensorNotFound" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "SensorId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "MongoDB id of the sensor (24 hexadecimal characters)",
        "schema": { "type": "string", "example": "6716a2f4c1d2e3f4a5b6c7d8" }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "The request data is not valid (missing fields, wrong types, thresholds out of order, invalid id...)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "status": "fail",
              "error": "ValidationError",
              "message": "The request data is not valid.",
              "details": [{ "field": "minThreshold", "message": "minThreshold must be lower than maxThreshold" }]
            }
          }
        }
      },
      "InvalidObjectId": {
        "description": "The id in the URL is not a valid MongoDB id",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "status": "fail",
              "error": "InvalidObjectId",
              "message": "'abc' is not a valid id (expected 24 hexadecimal characters)."
            }
          }
        }
      },
      "SensorNotFound": {
        "description": "No sensor exists with that id",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "status": "fail",
              "error": "NotFound",
              "message": "Sensor not found: 6716a2f4c1d2e3f4a5b6c7d8"
            }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": {
            "type": "object",
            "properties": {
              "service": { "type": "string", "example": "garden-monitoring-api" },
              "uptimeSeconds": { "type": "number", "example": 42.17 }
            }
          }
        }
      },
      "Magnitude": {
        "type": "string",
        "enum": ["soil_humidity", "temperature", "light"],
        "example": "temperature"
      },
      "Sensor": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "6716a2f4c1d2e3f4a5b6c7d8" },
          "name": { "type": "string", "example": "Bed thermometer" },
          "magnitude": { "$ref": "#/components/schemas/Magnitude" },
          "location": { "type": "string", "example": "Bed 1" },
          "isActive": { "type": "boolean", "example": true },
          "minThreshold": { "type": "number", "example": 5 },
          "maxThreshold": { "type": "number", "example": 35 },
          "unit": { "type": "string", "enum": ["%", "°C", "lx"], "example": "°C" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateSensorRequest": {
        "type": "object",
        "required": ["name", "magnitude", "location", "maxThreshold"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 100, "example": "Bed thermometer" },
          "magnitude": { "$ref": "#/components/schemas/Magnitude" },
          "location": { "type": "string", "minLength": 2, "maxLength": 100, "example": "Bed 1" },
          "minThreshold": { "type": "number", "description": "Optional lower limit of the normal range", "example": 5 },
          "maxThreshold": { "type": "number", "description": "Upper limit of the normal range", "example": 35 }
        }
      },
      "UpdateSensorRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 100 },
          "location": { "type": "string", "minLength": 2, "maxLength": 100 },
          "isActive": { "type": "boolean", "example": false },
          "minThreshold": { "type": "number" },
          "maxThreshold": { "type": "number" }
        }
      },
      "SensorResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "$ref": "#/components/schemas/Sensor" }
        }
      },
      "SensorListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Sensor" }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["status", "error", "message"],
        "properties": {
          "status": { "type": "string", "enum": ["fail", "error"], "example": "fail" },
          "error": { "type": "string", "example": "ValidationError" },
          "message": { "type": "string", "example": "The request data is not valid." },
          "details": {
            "type": "array",
            "description": "Only present on validation errors: one entry per invalid field.",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string", "example": "maxThreshold" },
                "message": { "type": "string", "example": "Expected number, received string" }
              }
            }
          }
        }
      }
    }
  }
}
